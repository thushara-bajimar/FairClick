# Copy to .env and adjust. All values are optional.
FAIRCLICK_HOST=127.0.0.1
FAIRCLICK_PORT=8000
# Where SQLite databases and evidence screenshots are stored (default: backend/data)
# FAIRCLICK_DATA_DIR=
FAIRCLICK_HEADLESS=true
FAIRCLICK_STEP_DELAY_MS=250
FAIRCLICK_MAX_STEPS=40
FAIRCLICK_APPROVAL_TIMEOUT_S=900

# Optional LLM second-opinion reviewer. Leave as "none" for the deterministic demo mode.
# A Claude Pro subscription does NOT include API access; an API key from the Claude Console is required.
FAIRCLICK_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
FAIRCLICK_ANTHROPIC_MODEL=claude-opus-5-5
